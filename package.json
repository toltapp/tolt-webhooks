{
  "name": "@tolt/webhooks",
  "version": "0.1.0",
  "description": "Verify and type Tolt webhooks. A dependency-free signature verifier plus typed events.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "tolt",
    "webhooks",
    "affiliate",
    "referral",
    "svix",
    "signature"
  ],
  "homepage": "https://github.com/toltapp/tolt-webhooks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toltapp/tolt-webhooks.git"
  },
  "bugs": {
    "url": "https://github.com/toltapp/tolt-webhooks/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
